+++ b/tests/unit/test_access_check.py
@@ -0,0 +1,93 @@
+"""access_check: the casper/access-check v1 contract, with every product API mocked."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+
+import pytest
+
+from hpe_networking_mcp.mcp_servers import access_check as ac
+
+
+def test_mist_self_roles():
+    assert ac.mist_access_from_self({"email": "ro@example.net", "privileges": [{"role": "read"}]})[0] == "read-only"
+    assert ac.mist_access_from_self({"privileges": [{"role": "read"}, {"role": "admin"}]})[0] == "read-write"
+    assert ac.mist_access_from_self({"privileges": [{"role": "helpdesk"}]})[0] == "read-write"
+    assert ac.mist_access_from_self({"privileges": []})[0] == "unknown"
+    assert ac.mist_access_from_self("nope")[0] == "unknown"
+
+
+def test_clearpass_privileges():
+    assert ac.clearpass_access_from_privileges({"privileges": ["#cppm_config", "#guest_users"]}) == "read-only"
+    assert ac.clearpass_access_from_privileges({"privileges": ["#cppm_config", "cppm_endpoints"]}) == "read-write"
+    assert ac.clearpass_access_from_privileges({"privileges": []}) == "unknown"
+    assert ac.clearpass_access_from_privileges(None) == "unknown"
+
+
+def test_glp_roles():
+    assert ac.glp_access_from_roles([{"permissions": ["central.devices.read", "glp.devices.view"]}]) == "read-only"
+    assert ac.glp_access_from_roles([{"permissions": ["central.devices.read"]}, {"permissions": ["central.config.update"]}]) == "read-write"
+    assert ac.glp_access_from_roles([{"permissions": []}]) == "unknown"
+    assert ac.glp_access_from_roles([None]) == "unknown"
+
+
+def _patch_mist(monkeypatch, payload):
+    from hpe_networking_mcp.mcp_servers import mist
+
+    async def fake(path, params=None, **_kwargs):
+        assert path == "/api/v1/self"
+        if isinstance(payload, Exception):
+            raise payload
+        return {"data": payload}
+
+    monkeypatch.setattr(mist, "_mist_get_request", fake)
+
+
+def _patch_clearpass(monkeypatch, privileges):
+    from hpe_networking_mcp.mcp_servers import clearpass
+
+    async def fake(path, params=None, **_kwargs):
+        if path == "/api/oauth/me":
+            return {"data": {"info": "svc-casper", "access_token": "SECRET-TOKEN"}}
+        assert path == "/api/oauth/privileges"
+        return {"data": {"privileges": privileges}}
+
+    monkeypatch.setattr(clearpass, "_clearpass_get_request", fake)
+
+
+@pytest.mark.parametrize(
+    ("mist_payload", "privileges", "expected"),
+    [
+        ({"email": "ro@example.net", "privileges": [{"role": "read"}]}, ["#cppm_config"], {"mist": "read-only", "clearpass": "read-only"}),
+        ({"privileges": [{"role": "admin"}]}, ["cppm_config"], {"mist": "read-write", "clearpass": "read-write"}),
+        (RuntimeError("boom"), ["#cppm_config"], {"mist": "unknown", "clearpass": "read-only"}),
+    ],
+)
+def test_report_per_product(monkeypatch, mist_payload, privileges, expected):
+    monkeypatch.setenv("HPE_MCP_ACCESS_PROFILE", "safe-read-only")
+    _patch_mist(monkeypatch, mist_payload)
+    _patch_clearpass(monkeypatch, privileges)
+    report = asyncio.run(ac.build_access_report({"mist", "clearpass"}))
+    assert report["contract"] == "casper/access-check v1"
+    assert {p["product"]: p["access"] for p in report["products"]} == expected
+    for product in report["products"]:
+        assert product["server_gate"]["state"] == "disabled"
+    assert "SECRET-TOKEN" not in json.dumps(report)
+
+
+def test_only_loaded_platforms_are_reported(monkeypatch):
+    _patch_mist(monkeypatch, {"privileges": [{"role": "read"}]})
+    report = asyncio.run(ac.build_access_report({"mist"}))
+    assert [p["product"] for p in report["products"]] == ["mist"]
+
+
+def test_tool_is_read_only_and_present_in_minimal_router_mode():
+    from hpe_networking_mcp.mcp_servers import tool_router
+
+    tools = {tool.name: tool for tool in asyncio.run(tool_router.mcp.list_tools())}
+    assert "access_check" in tools
+    annotations = tools["access_check"].annotations
+    assert annotations.readOnlyHint is True
+    assert annotations.destructiveHint is False
+    assert not tools["access_check"].inputSchema.get("required")
