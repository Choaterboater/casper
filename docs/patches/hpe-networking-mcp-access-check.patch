new file mode 100644
--- /dev/null
+++ b/src/hpe_networking_mcp/mcp_servers/access_check.py
@@ -0,0 +1,225 @@
+"""Router-level ``access_check`` tool: what may the configured logins do?
+
+Answers the ``casper/access-check v1`` contract so an MCP client (Casper, for
+one) can show "login: read-only (checked)" and hide write tools before the
+model plans. The answer comes from each product's own API, never from this
+server's settings, and it only ever restricts a client: a "read-write" answer
+unlocks nothing on the client side.
+
+Shape::
+
+    {"contract": "casper/access-check v1",
+     "products": [{"product": "mist", "access": "read-only" | "read-write" | "unknown",
+                   "identity": "...", "role": "...",
+                   "server_gate": {"env_var": "HPE_MCP_MIST_WRITES", "state": "disabled"}}]}
+
+Only platforms whose backend is loaded are reported. Tokens, secrets and raw
+API payloads are never returned; identity and role are short display strings.
+Any error, timeout or unexpected payload gives ``"unknown"`` for that product.
+
+Endpoints marked CONFIRM below must be checked against ``vendor/openapi`` before
+this ships; until then those products report ``"unknown"`` on any mismatch.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import re
+from collections.abc import Awaitable, Callable, Iterable
+from typing import Any
+
+from hpe_networking_mcp.mcp_servers.shared import READ_ONLY, platform_write_gate_state
+
+CONTRACT = "casper/access-check v1"
+_PER_PRODUCT_TIMEOUT_S = 10.0
+_PLAIN = re.compile(r"^[A-Za-z0-9 _.@:/+-]{1,64}$")
+
+#: Mist privilege roles that cannot change anything. CONFIRM: "helpdesk" can
+#: run some client actions (reauth, disconnect); it is left out until checked.
+MIST_READ_ONLY_ROLES = frozenset({"read"})
+#: GLP/Central permission verbs that mean a change.
+_WRITE_VERBS = ("create", "update", "delete", "write", "edit", "manage", "all", "*")
+
+
+def _plain(value: Any) -> str | None:
+    return value if isinstance(value, str) and _PLAIN.match(value) else None
+
+
+def _gate(platform: str) -> dict[str, str] | None:
+    try:
+        state = platform_write_gate_state(platform)
+    except ValueError:
+        return None
+    return {"env_var": str(state.get("env_var", "")), "state": str(state.get("state", "unknown"))}
+
+
+def _product(
+    platform: str, access: str, identity: Any = None, role: Any = None
+) -> dict[str, Any]:
+    entry: dict[str, Any] = {"product": platform, "access": access}
+    if _plain(identity):
+        entry["identity"] = identity
+    if _plain(role):
+        entry["role"] = role
+    gate = _gate(platform)
+    if gate:
+        entry["server_gate"] = gate
+    return entry
+
+
+# ---------------------------------------------------------------------------
+# Mist: GET /api/v1/self
+# ---------------------------------------------------------------------------
+
+
+def mist_access_from_self(payload: Any) -> tuple[str, str | None, str | None]:
+    """Read-only only when every privilege role is a read-only role."""
+    if not isinstance(payload, dict):
+        return "unknown", None, None
+    privileges = payload.get("privileges")
+    if not isinstance(privileges, list) or not privileges:
+        return "unknown", None, None
+    roles = [p.get("role") for p in privileges if isinstance(p, dict)]
+    if len(roles) != len(privileges) or not all(isinstance(r, str) for r in roles):
+        return "unknown", None, None
+    identity = payload.get("email") or payload.get("name")
+    role = ",".join(sorted(set(roles)))
+    if all(r in MIST_READ_ONLY_ROLES for r in roles):
+        return "read-only", identity, role
+    return "read-write", identity, role
+
+
+async def _mist() -> dict[str, Any]:
+    from hpe_networking_mcp.mcp_servers import mist
+
+    out = await mist._mist_get_request("/api/v1/self", bound=False)
+    access, identity, role = mist_access_from_self(out.get("data") if isinstance(out, dict) else None)
+    return _product("mist", access, identity, role)
+
+
+# ---------------------------------------------------------------------------
+# ClearPass: GET /api/oauth/me + GET /api/oauth/privileges
+# ---------------------------------------------------------------------------
+
+
+def clearpass_access_from_privileges(payload: Any) -> str:
+    """Read-only when no privilege grants write. ClearPass marks read-only
+    privileges with a leading '#' (e.g. '#cppm_config'); CONFIRM against 6.11+."""
+    if not isinstance(payload, dict):
+        return "unknown"
+    privileges = payload.get("privileges")
+    if not isinstance(privileges, list) or not privileges:
+        return "unknown"
+    if not all(isinstance(p, str) for p in privileges):
+        return "unknown"
+    return "read-only" if all(p.startswith("#") for p in privileges) else "read-write"
+
+
+async def _clearpass() -> dict[str, Any]:
+    from hpe_networking_mcp.mcp_servers import clearpass
+
+    me = await clearpass._clearpass_get_request("/api/oauth/me", bound=False)
+    privileges = await clearpass._clearpass_get_request("/api/oauth/privileges", bound=False)
+    me_data = me.get("data") if isinstance(me, dict) else None
+    identity = me_data.get("info") or me_data.get("client_id") if isinstance(me_data, dict) else None
+    access = clearpass_access_from_privileges(
+        privileges.get("data") if isinstance(privileges, dict) else None
+    )
+    return _product("clearpass", access, identity)
+
+
+# ---------------------------------------------------------------------------
+# Central / GLP: role assignments for the token's principal
+# ---------------------------------------------------------------------------
+
+
+def glp_access_from_roles(roles: Iterable[Any]) -> str:
+    """Read-only when no role grants a change on the Central or GLP apps."""
+    seen = False
+    for role in roles:
+        if not isinstance(role, dict) or not isinstance(role.get("permissions"), list):
+            return "unknown"
+        for permission in role["permissions"]:
+            if not isinstance(permission, str):
+                return "unknown"
+            seen = True
+            verb = permission.rsplit(".", 1)[-1].lower()
+            if any(word in verb for word in _WRITE_VERBS):
+                return "read-write"
+    return "read-only" if seen else "unknown"
+
+
+async def _central_glp() -> list[dict[str, Any]]:
+    from hpe_networking_mcp.mcp_servers import glp
+
+    # CONFIRM: principal format and the filter syntax in vendor/openapi/glp.
+    whoami = await asyncio.to_thread(glp.glp_get, "/identity/v1/users/me")
+    principal = whoami.get("data", {}).get("id") if isinstance(whoami, dict) else None
+    access = "unknown"
+    role_names: list[str] = []
+    if isinstance(principal, str) and _plain(principal):
+        assignments = await asyncio.to_thread(
+            glp.glp_get,
+            "/authorization/v1beta1/role-assignments",
+            {"filter": f"principal in ('{principal}')"},
+        )
+        items = assignments.get("data", {}).get("items") if isinstance(assignments, dict) else None
+        if isinstance(items, list) and items:
+            roles = []
+            for item in items[:20]:
+                role_id = item.get("roleId") if isinstance(item, dict) else None
+                if not isinstance(role_id, str) or not _plain(role_id):
+                    roles = [None]
+                    break
+                role = await asyncio.to_thread(glp.glp_get, f"/authorization/v1beta1/roles/{role_id}")
+                data = role.get("data") if isinstance(role, dict) else None
+                roles.append(data)
+                if isinstance(data, dict) and _plain(data.get("name")):
+                    role_names.append(data["name"])
+            access = glp_access_from_roles(roles)
+    role = ",".join(sorted(set(role_names)))[:64] or None
+    return [_product("central", access, principal, role), _product("glp", access, principal, role)]
+
+
+# ---------------------------------------------------------------------------
+# The tool
+# ---------------------------------------------------------------------------
+
+
+async def _bounded(platforms: list[str], check: Callable[[], Awaitable[Any]]) -> list[dict[str, Any]]:
+    try:
+        result = await asyncio.wait_for(check(), timeout=_PER_PRODUCT_TIMEOUT_S)
+    except Exception:  # noqa: BLE001 - any failure is "unknown", never an error payload
+        return [_product(platform, "unknown") for platform in platforms]
+    return result if isinstance(result, list) else [result]
+
+
+async def build_access_report(enabled_platforms: set[str]) -> dict[str, Any]:
+    checks: list[tuple[list[str], Callable[[], Awaitable[Any]]]] = []
+    if "central" in enabled_platforms or "glp" in enabled_platforms:
+        checks.append((["central", "glp"], _central_glp))
+    if "mist" in enabled_platforms:
+        checks.append((["mist"], _mist))
+    if "clearpass" in enabled_platforms:
+        checks.append((["clearpass"], _clearpass))
+    results = await asyncio.gather(*(_bounded(platforms, check) for platforms, check in checks))
+    products = [
+        product
+        for group in results
+        for product in group
+        if product.get("product") in enabled_platforms
+    ]
+    return {"contract": CONTRACT, "products": products}
+
+
+def register_access_check(mcp: Any, *, enabled_platforms: set[str]) -> None:
+    """Register ``access_check`` on the router. Always on, like catalog-core."""
+
+    @mcp.tool(annotations=READ_ONLY)
+    async def access_check() -> dict[str, Any]:
+        """Report whether each configured login is read-only, from each product's own API.
+
+        Takes no arguments. Returns the casper/access-check v1 contract. Never
+        returns tokens. Unknown or failed checks report access "unknown".
+        """
+        return await build_access_report(enabled_platforms)
