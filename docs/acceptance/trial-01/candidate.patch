+    resolvedCwd,
+  );
+  // Ref names cannot contain newlines, but directory names can. Put the
+  // full ref first and split only once, leaving the absolute root intact.
+  const separator = combined?.indexOf("\n") ?? -1;
+  const ref = separator >= 0 ? combined!.slice(0, separator) : null;
