{
  "id": "web-app",
  "version": 2,
  "kind": "web app",
  "title": "Web app (React, Tailwind, Bun)",
  "description": "A React web app on Bun with Tailwind and a small theme of its own, a page test and a typecheck.",
  "defaultName": "my-app",
  "tool": "bun",
  "init": [
    "bun",
    "init",
    "--react=tailwind",
    "-y"
  ],
  "add": [],
  "addDev": [
    "@happy-dom/global-registrator"
  ],
  "replace": [
    "README.md",
    "bunfig.toml",
    "src/App.tsx",
    "src/APITester.tsx",
    "src/index.css",
    "src/index.html"
  ],
  "packageJson": {
    "name": "{{name}}",
    "scripts": {
      "test": "bun test",
      "typecheck": "tsc --noEmit"
    }
  },
  "ready": true
}
